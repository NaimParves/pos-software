{
  "name": "pos-software",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:server:dev\" \"npm:client\"",
    "client": "vite",
    "server": "node server/index.js",
    "server:dev": "node --watch-path=server server/index.js",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "start": "npm run build && node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "vite": "5.4.11"
  }
}
